<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Cast Button Container -->
    <FrameLayout
        android:id="@+id/pip_container"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="top|start"
        android:layout_margin="16dp"
        android:background="@drawable/circle_background">

        <ImageButton
            android:id="@+id/ib_pip"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:layout_gravity="center"
            android:src="@drawable/ic_pip" />
    </FrameLayout>

    <!-- Added Top Controls Container for Subtitle and Cast -->
    <LinearLayout
        android:id="@+id/top_controls_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:orientation="horizontal">

        <!-- Subtitle Button -->
        <ImageButton
            android:id="@+id/ib_subtitle"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_background"
            android:padding="6dp"
            android:src="@drawable/ic_closed_caption" />

        <Space
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!-- Cast Button Container -->
        <FrameLayout
            android:id="@+id/cast_container"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/circle_background">

            <androidx.mediarouter.app.MediaRouteButton
                android:id="@+id/cast_button"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center" />
        </FrameLayout>
    </LinearLayout>

</FrameLayout>